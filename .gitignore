# ===== Python 编译缓存 =====
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# ===== 本机环境与运行配置（不入库；opc-config.json 用环境变量可覆盖） =====
.env
opc-config.json

# ===== 运行数据：控制台的业务产物（任务队列 / 调度日志 / 回报 / 派发单 / 决策 / 每日简报 / 运行监控） =====
# 由 bootstrap 自动幂等重建骨架，不属于仓库代码
批阅台/
工作区/
知识库/

# ===== 临时文件 =====
*.log
.DS_Store
Thumbs.db
scratch_*.py
# 调度日志（运行数据）
运营-调度日志.md

# ===== 打包产物（本机保留，不入库）=====
# 注：打包用的 scripts/build.ps1 与 scripts/opc-web.spec 随仓库走（要能复现构建）
build/
dist/
_seed/
_已打包/              # 旧的发布暂存目录（如有）

# ===== 本地诊断与运行输出（本机保留，不入库）=====
scripts/.diag-regen.py
.diag-regen.py
server.out.log
server.err.log

# 用例落下的临时目录（见 tests/_tmpdir.py）
.testroot-*/

# 本地探针与运行日志（截图/临时页/服务输出），不进仓库
_*.png
_*.html

# 运行日志，不进仓库
logs/

# 本地诊断用的 git worktree（git add -A 会把目录当子模块指针提交，别重犯）
_ci_probe/
